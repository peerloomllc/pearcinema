{
  "expo": {
    "name": "PearCinema",
    "slug": "pearcinema",
    "version": "1.1.1",
    "newArchEnabled": true,
    "orientation": "portrait",
    "scheme": "pear",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.pearcinema",
      "versionCode": 1001008,
      "permissions": [
        "CAMERA",
        "INTERNET",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "pear",
              "host": "pearcinema",
              "pathPrefix": "/pair"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#171410"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.pearcinema",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "lightning"
        ],
        "NSLocalNetworkUsageDescription": "PearCinema plays straight from your library when it is on the same network, instead of sending your films out to the internet and back.",
        "NSCameraUsageDescription": "PearCinema scans a pairing QR code to connect to your library host.",
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "127.0.0.1": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      },
      "buildNumber": "10"
    },
    "plugins": [
      [
        "expo-router"
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 288,
          "backgroundColor": "#171410",
          "resizeMode": "contain"
        }
      ],
      "./plugins/with-android-abis",
      "./plugins/with-android-debug-app-id",
      "./plugins/with-android-release-signing",
      "./plugins/with-android-queries",
      "./plugins/with-localhost-cleartext",
      "./plugins/with-standalone-debug",
      "./plugins/with-webview-recovery",
      "expo-video",
      "expo-font"
    ],
    "assets": [
      "./assets/bare-universal.bundle"
    ],
    "icon": "./assets/icon.png"
  }
}
