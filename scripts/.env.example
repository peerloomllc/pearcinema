# Release secrets for scripts/release.sh.
#
# Copy to scripts/.env and fill in. THAT FILE IS GITIGNORED (.gitignore line 58); this
# example file is committed, so never put a real value in it.
#
# app.conf holds everything that is not secret. If a value is safe to publish it belongs
# there instead.
#
# MOST OF THIS IS ACCOUNT-WIDE AND ALREADY EXISTS FOR PEARTUNE, so the fastest way to
# fill this in is to copy ../peartune/scripts/.env and change the two per-app values.
# Which are which is marked on every line below.

# ── iOS: App Store Connect ──────────────────────────────────────────────────
#
# The private key is already on this machine at ~/.appstoreconnect/AuthKey_28U2P9D99H.p8,
# which is where release.sh looks by default, so the key id below is just what that file
# is named after.

# ACCOUNT-WIDE. The string in the AuthKey_<KEY_ID>.p8 filename.
ASC_KEY_ID=28U2P9D99H

# ACCOUNT-WIDE, a UUID. App Store Connect -> Users and Access -> Integrations -> App Store
# Connect API. Per TEAM, so it is the same value PearTune uses.
ASC_ISSUER_ID=

# PER APP, and the one thing that cannot be copied or looked up until PearCinema exists in
# App Store Connect. Create the app there first, then read the number from App Information
# -> General Information -> Apple ID. It is also the number in that page's URL.
ASC_APP_ID=

# Only if the .p8 lives somewhere other than ~/.appstoreconnect/AuthKey_<ASC_KEY_ID>.p8.
#ASC_PRIVATE_KEY_PATH=

# The older altool route, used only when the three above are not all set. Apple has been
# narrowing it; prefer the API key.
#ASC_APPLE_ID=
#ASC_APP_PASSWORD=

# ── Android: signing ────────────────────────────────────────────────────────
#
# The keystore at ~/keystore.jks is the suite's, and app.conf already names PearCinema's
# alias (KEY_ALIAS_DEFAULT=pearcinema). CHECK THE ALIAS IS ACTUALLY IN THERE before the
# first release - `keytool -list -keystore ~/keystore.jks` will say - because an alias that
# has never been generated fails at signing time, after a full build.
KEYSTORE_PASSWORD=
KEY_PASSWORD=

# Only if the keystore or alias is not the default above.
#KEYSTORE_FILE=$HOME/keystore.jks
#KEY_ALIAS=pearcinema

# ── Android: Play Console ───────────────────────────────────────────────────
#
# ACCOUNT-WIDE. Two ways to authenticate and release.sh tries them in this order: a service
# account JSON, or gcloud application-default credentials. With ADC the Play API demands a
# quota project on every request, which is what PLAY_QUOTA_PROJECT is for.
#PLAY_SERVICE_ACCOUNT_JSON=
#PLAY_QUOTA_PROJECT=

# internal / alpha / beta / production. Defaults to alpha, which is the safe first release.
PLAY_TRACK=alpha

# ── Zapstore ────────────────────────────────────────────────────────────────
#
# ACCOUNT-WIDE. The Nostr secret key the Zapstore listing is signed with. Required, and
# release.sh stops on it early rather than after a build.
SIGN_WITH=

# ── Everything else ─────────────────────────────────────────────────────────

# A clone of the PeerLoom community Umbrel app store, which step 13c syncs the listing
# into. PearCinema is already published there, so this one matters.
#UMBREL_STORE_DIR=

# GitHub PAT. Falls back to `gh auth token`, which is already logged in on this machine, so
# it is normally unnecessary.
#GITHUB_TOKEN=

# Which editor opens the release notes and the Nostr draft, the only interactive editing
# release.sh does. Defaults to vim and deliberately ignores $EDITOR.
#RELEASE_EDITOR=vim
