node_modules/
.expo/
dist/
web-build/

# Build artifacts
assets/bare-universal.bundle
assets/bare-ios.bundle
assets/app-ui.bundle
# esbuild emits the stylesheet beside the bundle; build-ui.mjs then INLINES it into
# assets/index.html, which is what the app loads. So this is an intermediate like the
# bundle beside it, not a shipped file - it was tracked by oversight until 2026-07-26.
assets/app-ui.css
assets/index.html
host/ui/build/
# Intermediate esbuild outputs for the dashboard; host/ui/dashboard.html (the
# inlined result) IS committed - the image's Dockerfile copies host/ with no
# build step, so the served artifact must be in the tree.
host/ui/app/.dashboard.bundle
host/ui/app/.dashboard.css
*.apk
*.aab
*.ipa
*.sha256
release_notes.md

# Host runtime data (identity seed, grant store) - NEVER commit
host-data/
*.seed

# Local-only docs (per CLAUDE.md)
TODO.md
DONE.md

# deno bundle lockfile (start9 s9pk procedures)
/deno.lock

# Recorded demo videos (scripts/ios-sim-demo-video.sh writes here) and the screen-recorded
# dashboard clips they get cut together with. Build OUTPUT, not source - the phone half is
# reproducible from the app, the dashboard half is a re-shoot, and takes pile up fast.
pearcinema-demo-ios.mp4
*.mp4
*.webm

# Screenshot fixtures: real album art from a live library. Never committed - see
# scripts/screenshot-fixture.sh for why.
metadata/screenshot-fixtures/
# ...and the CAPTURES made from them, for the same reason: every frame is a grid of that
# same album art, so committing the output would put in the repo exactly what the line above
# keeps out. They are build output anyway - scripts/screenshots.sh and
# scripts/android-screenshots.sh reproduce them from the fixture in a couple of minutes.
metadata/ios/screenshots/
metadata/android/screenshots/

# Release secrets. app.conf says "scripts/.env is not [committed]" and nothing was
# enforcing it - scripts/ios-appstore.sh tells you to put an App Store Connect app-specific
# password in there. Checked 2026-07-31: `git check-ignore scripts/.env` said NOT IGNORED.
scripts/.env

# The generated Android project. Regenerated by `expo prebuild`; the SOURCE is
# app.json plus the config plugins, per suite rule 5 - edit those, never this.
# (PearTune commits its android/ as a documented exception; this repo takes the
# suite default.) Anchored to the root on purpose: modules/*/android is SOURCE
# (local Expo modules carry their own android dir) and an unanchored android/
# would silently drop it from every commit.
/android/

# A local module's android/ is SOURCE, but its android/build is gradle's output -
# a few hundred .dex files that turn up in `git status` after every APK build and
# have no business in a commit.
modules/*/android/build/

# UI build intermediates
src/ui/.phone.bundle
src/ui/.phone.css
.expo/

# Bundled ffmpeg binaries - dropped in by desktop packaging, never committed.
# The README documenting the convention IS committed.
vendor/ffmpeg/*
!vendor/ffmpeg/README.md

# The demo library - about 160 MB of public-domain film, fetched and encoded by
# scripts/fetch-demo-films.sh from the archive.org identifiers recorded there. Video
# that every clone would carry for ever and that git stores badly, so the repo keeps
# the identifiers and the licence evidence instead. LICENCES.md IS committed, because
# the evidence is the part that must not be re-derived.
# The posters are frame grabs of those same films, made by the same script.
assets/demo-library/*
!assets/demo-library/LICENCES.md
# The catalogue IS committed: it is a few kilobytes, it is what the app builds the demo
# library from, and its file names are the keys the shell resolves the assets by.
!assets/demo-library/manifest.json
# AND THE SUBTITLES ARE COMMITTED, because we wrote them. The fetch script cannot
# reproduce a caption file the way it reproduces a film, and LICENCES.md's rule is that
# any subtitle shipped beside these is ours rather than a third party's. Git cannot
# re-include a file inside an excluded directory, so Films/ is re-admitted and then
# emptied again except for the .srt.
!assets/demo-library/Films/
assets/demo-library/Films/*
!assets/demo-library/Films/*.srt
